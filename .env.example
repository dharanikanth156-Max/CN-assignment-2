# ==============================================================================
# APEX UNIVERSITY NOTIFICATION ENGINE CONFIGURATION
# ==============================================================================

# Application & Auth
PROJECT_NAME="College Email Notification System"
VERSION="1.0.0"
SECRET_KEY="super-secret-jwt-college-key-change-in-production-2026"
FERNET_KEY="7xV-3r1eF0Tz_eZ5kG1r0n2fB8rJ4yQ6kL3oP9mN0xY="
UNSUBSCRIBE_SECRET="college-unsub-secret-key-safe"

# Database Configuration (SQLite default; can be Postgres: postgresql+asyncpg://user:pass@host:5432/dbname)
DATABASE_URL="sqlite+aiosqlite:///./college_email.db"
SYNC_DATABASE_URL="sqlite:///./college_email.db"

# SMTP Relay Defaults (Mailpit / Mock Server on port 1025)
DEFAULT_SMTP_HOST="127.0.0.1"
DEFAULT_SMTP_PORT=1025
DEFAULT_SMTP_SECURITY="none" # none | starttls | ssl
DEFAULT_SMTP_USER=""
DEFAULT_SMTP_PASSWORD=""
DEFAULT_SENDER_NAME="Apex University Academic Office"
DEFAULT_SENDER_EMAIL="notifications@apex.edu"
MAILPIT_WEB_URL="http://localhost:8025"

# Concurrency & Rate Limiting
SMTP_MAX_WORKERS=4
SMTP_BATCH_SIZE=25
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_PER_DAY=5000

# Front & Back End URLs
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:8000"
